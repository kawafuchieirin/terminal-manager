#####################################################################
# secrets.zsh — シークレット（トークン・APIキー）のテンプレート
#
# 使い方:
#   1. このファイルを secrets.zsh にコピー
#        cp secrets.zsh.example secrets.zsh
#   2. 値を実物に書き換える
#   3. secrets.zsh は .gitignore で除外されるため push されない／pull で消えない
#
# 会社Mac・個人Macそれぞれで、そのマシン用の値を埋める。
# このテンプレート（.example）にはダミー値のみを置き、実トークンは書かない。
#####################################################################

# 例: Slack
export SLACK_USER_TOKEN="xoxb-000000000000-000000000000-xxxxxxxxxxxxxxxxxxxxxxxx"
export SLACK_CHANNEL_ID="C00000000000"

# 例: AWS / その他 API キー（必要なものだけ追記）
# export AWS_ACCESS_KEY_ID="AKIAXXXXXXXXXXXXXXXX"
# export AWS_SECRET_ACCESS_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# export OPENAI_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
