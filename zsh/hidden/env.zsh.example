#####################################################################
# env.zsh — マシン固有の非秘匿設定（PATH・会社用エイリアス等）のテンプレート
#
# 使い方:
#   1. このファイルを env.zsh にコピー
#        cp env.zsh.example env.zsh
#   2. そのマシン（会社 / 個人）固有の設定を書く
#   3. env.zsh は .gitignore で除外されるため push されない／pull で消えない
#
# シークレットはここではなく secrets.zsh に書く（用途で分離）。
# git のメール・名前は ~/.gitconfig（リポジトリ外）で設定する:
#   git config --global user.name  "Your Name"
#   git config --global user.email "you@example.com"
#####################################################################

# 例: マシン固有の PATH
# export PATH="$HOME/work/bin:$PATH"

# 例: 社内プロキシ
# export HTTP_PROXY="http://proxy.example.com:8080"
# export HTTPS_PROXY="http://proxy.example.com:8080"

# 例: そのマシンだけで使うエイリアス・関数
# alias deploy='./scripts/deploy.sh'
